# ────────────────────────────────────────────────────────────────────────────
# Режим данных.
#   mock — фронт работает автономно на снимке данных в public/mock (демо без бэка)
#   api  — фронт ходит в реальный бэкенд SourceCraft Repo Health
VITE_DATA_SOURCE=mock

# База API. В dev можно оставить /api — Vite проксирует на VITE_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Куда Vite проксирует /api в режиме разработки
VITE_PROXY_TARGET=http://localhost:8000

# Показывать ли плашку «демо-данные» в интерфейсе (в mock-режиме включена всегда)
VITE_SHOW_DEMO_BANNER=true
